{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "productName": "EClaw Desktop",
  "version": "0.1.0",
  "identifier": "com.eclaw.desktop",
  "build": {
    "devtools": true,
    "beforeBuildCommand": "",
    "beforeDevCommand": ""
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://eclawbot.com https://eclaw.up.railway.app",
      "assetProtocol": {
        "enable": false
      }
    },
    "windows": [
      {
        "title": "EClaw Desktop",
        "label": "main",
        "width": 480,
        "height": 640,
        "minWidth": 400,
        "minHeight": 500,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
